# Application Settings
APP_NAME="Local Assistant"
APP_ENV="development"
DEBUG=false

# Logging Configuration
LOG_LEVEL="INFO"
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Storage Directories
DATA_DIR="data"
LOGS_DIR="logs"

# Ollama Model Configuration
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_MODEL="llama3"
OLLAMA_TIMEOUT_SECONDS=60

# Conversation Engine Settings (Phase 2)
MAX_CONVERSATION_MESSAGES=50
SYSTEM_PROMPT="You are a helpful local AI personal assistant."

# Tool Calling Settings (Phase 3)
MAX_TOOL_CALL_ROUNDS=5

# Permission and Safety Settings (Phase 4)
AUTO_APPROVE_READ_TOOLS=true
AUTO_APPROVE_LOW_RISK_TOOLS=true
REQUIRE_CONFIRMATION_MEDIUM=true
REQUIRE_CONFIRMATION_HIGH=true
ALLOW_CRITICAL_TOOLS=false

# File-System Settings (Phase 5)
FILESYSTEM_ALLOWED_ROOTS=
FILESYSTEM_PROTECTED_PATHS=
MAX_FILE_READ_BYTES=1048576
MAX_FILE_WRITE_BYTES=1048576
MAX_SEARCH_RESULTS=100
MAX_LIST_RESULTS=200

# System and Application Settings (Phase 6)
MAX_PROCESS_RESULTS=100
APPLICATION_LAUNCH_TIMEOUT_SECONDS=3.0
APPLICATION_CLOSE_TIMEOUT_SECONDS=3.0

# Controlled Terminal and Execution Settings (Phase 7)
COMMAND_TIMEOUT_SECONDS=30.0
MAX_COMMAND_OUTPUT_BYTES=65536
PYTHON_EXECUTABLE=
COMPILER_EXECUTABLE=
GIT_EXECUTABLE=

# Persistent Memory Settings (Phase 8)
MEMORY_DATABASE_PATH="data/assistant.db"
MAX_PERSISTED_MESSAGES=500
MAX_RECALLED_MEMORIES=5

# Personal Knowledge / RAG Settings (Phase 9)
KNOWLEDGE_DATA_DIR="data/knowledge"
KNOWLEDGE_DATABASE_PATH="data/knowledge/knowledge.db"
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="local-hash-384"
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
MAX_RAG_CONTEXT_CHUNKS=4
MAX_RAG_CONTEXT_BYTES=8192
MAX_INDEXED_FILES_PER_OPERATION=50
MAX_DOCUMENT_SIZE_BYTES=10485760

# Browser Automation Settings (Phase 10)
BROWSER_HEADLESS=true
BROWSER_PAGE_TIMEOUT_SECONDS=30.0
BROWSER_ACTION_TIMEOUT_SECONDS=15.0
BROWSER_SESSION_TIMEOUT_SECONDS=900.0
MAX_BROWSER_TEXT_BYTES=32768
MAX_BROWSER_ELEMENTS=100
ALLOW_LOCAL_NETWORK=false

# Local Voice Input / STT Settings (Phase 12)
VOICE_ENABLED=true
STT_MODEL="base"
STT_DEVICE="cpu"
STT_COMPUTE_TYPE="int8"
AUDIO_SAMPLE_RATE=16000
MAX_RECORDING_SECONDS=60
SELECTED_MICROPHONE=

# Local Text-to-Speech / TTS Settings (Phase 13)
TTS_ENABLED=true
TTS_PROVIDER="pyttsx3"
TTS_VOICE=
TTS_SPEED_RATE=175
AUTO_SPEAK_RESPONSES=false
MAX_TTS_CHARACTERS=1500
SELECTED_AUDIO_OUTPUT=

# Tasks, Scheduling and Automation Settings (Phase 14)
TASKS_ENABLED=true
AUTOMATION_ENABLED=true
START_IN_BACKGROUND=false
MAX_ACTIVE_TRIGGERS=20
MAX_EVENT_HISTORY=100
MAX_EVENTS_PER_SECOND=20
FILE_WATCH_DEBOUNCE_MS=500
SYSTEM_MONITOR_INTERVAL_SECONDS=5.0
DEFAULT_TRIGGER_COOLDOWN_SECONDS=300
SPEAK_BACKGROUND_NOTIFICATIONS=false
MAX_CONCURRENT_TASKS=2
TASK_SCHEDULER_POLL_SECONDS=2.0
MISSED_TASK_POLICY="skip"
MAX_TASK_EXECUTION_SECONDS=300
TASKS_DATABASE_PATH=












